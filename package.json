{
  "name": "reelnote",
  "version": "1.0.0",
  "description": "Review your Remotion video straight from code, frame by frame. Mark what's wrong; Claude Code reads the note, fixes the code and checks the frame. Render once at the end, with every frame checked.",
  "type": "module",
  "bin": {
    "reelnote": "dist/cli.js"
  },
  "files": [
    "dist",
    "client",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "node --test test/unit/*.test.mjs",
    "e2e": "node test/e2e.mjs"
  },
  "keywords": [
    "remotion",
    "video",
    "review",
    "claude",
    "claude-code",
    "mcp",
    "frame-check"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@remotion/player": "^4.0.545",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.545",
    "typescript": "^5.7.0"
  }
}
